!> Tests proportional water partitioning, positivity limiting and dry-level handling.
module ennuf_moisture_kernel_mod_test
  use funit
  use constants_mod, only: r_def
  use ennuf_moisture_kernel_mod, only: partition_water_increment
  implicit none

  @TestCase
  type, extends(TestCase) :: ennuf_moisture_test_type
  contains
    procedure :: test_partition
  end type ennuf_moisture_test_type

contains

  @test
  subroutine test_partition(this)
    class(ennuf_moisture_test_type), intent(inout) :: this
    real(r_def) :: initial(4), updated(4), current(4)
    real(r_def), parameter :: tol = 1.e-14_r_def

    initial = [0.006_r_def, 0.002_r_def, 0.001_r_def, 0.001_r_def]
    call partition_water_increment(initial, initial, 0.005_r_def, updated)
    @assertEqual(1.5_r_def * initial, updated, tolerance=tol)
    call partition_water_increment(initial, initial, -0.005_r_def, updated)
    @assertEqual(0.5_r_def * initial, updated, tolerance=tol)
    call partition_water_increment(initial, initial, -0.02_r_def, updated)
    @assertTrue(all(abs(updated) < tol))
    call partition_water_increment(initial, initial, 0.0_r_def, updated)
    @assertEqual(initial, updated, tolerance=tol)

    current = initial
    current(2) = 0.0001_r_def
    call partition_water_increment(initial, current, -0.005_r_def, updated)
    @assertTrue(all(updated >= 0.0_r_def))
    @assertEqual(current - 0.05_r_def * initial, updated, tolerance=tol)

    initial = 0.0_r_def
    call partition_water_increment(initial, initial, 0.005_r_def, updated)
    @assertTrue(all(updated == 0.0_r_def))
    call partition_water_increment(initial, initial, -0.005_r_def, updated)
    @assertTrue(all(updated == 0.0_r_def))
  end subroutine test_partition
end module ennuf_moisture_kernel_mod_test
